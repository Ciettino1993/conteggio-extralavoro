{
  "name": "conteggio-extralavoro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Conteggio Extralavoro - costo dei viaggi di lavoro: carburante e tempo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ciettino1993/conteggio-extralavoro.git"
  },
  "scripts": {
    "fuel:update": "node scripts/update-fuel.mjs",
    "predev": "node scripts/update-fuel.mjs --if-stale",
    "dev": "vite",
    "dev:telefono": "vite --host --mode phone",
    "prebuild": "node scripts/update-fuel.mjs --if-stale",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fuel:pubblica": "node scripts/pubblica-carburanti.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
